# Explicit empty auth so `pnpm install` works for anyone cloning this repo
# regardless of whether they have NPM_TOKEN set globally. Public npm package
# reads don't require authentication; this file overrides any user-global
# `~/.npmrc` at project scope.
//registry.npmjs.org/:_authToken=

# pnpm: fail fast if lockfile is out of sync in CI (set via --frozen-lockfile).
auto-install-peers=true
strict-peer-dependencies=false
